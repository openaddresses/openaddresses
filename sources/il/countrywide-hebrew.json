{
    "coverage": {
        "country": "il",
        "ISO 3166": {
            "alpha2": "IL",
            "country": "Israel"
        }
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "country",
                "data": "https://www.sol-israel.co.il/arcgis/rest/services/Amidar_Vector/MapServer/9",
                "protocol": "ESRI",
                "skip": true,
                "language": "HE",
                "conform": {
                    "format": "geojson",
                    "city": "SETL_NAME",
                    "number": {
                        "function": "format",
                        "fields": [
                            "HOUSE_NUM",
                            "ENTRY_LETR"
                        ],
                        "format": "$1$2"
                    },
                    "unit": "ENTRY_LETR",
                    "street": "STR_FULNAM"
                }
            }
        ],
        "parcels": [
            {
                "name": "country",
                "data": "https://data.openaddresses.io/cache/uploads/jeffdefacto/2026-10-01-mrflm/parcel_all.zip",
                "website": "https://data.gov.il/api/3/action/package_show?id=shape",
                "protocol": "http",
                "compression": "zip",
                "license": {
                    "url": "https://data.gov.il/he/terms-of-use",
                    "attribution": true,
                    "attribution name": "Survey of Israel"
                },
                "conform": {
                    "format": "shapefile",
                    "file": "PARCEL_ALL.shp",
                    "srs": "EPSG:2039",
                    "encoding": "cp1255",
                    "pid": {
                        "function": "format",
                        "fields": [
                            "GUSH_NUM",
                            "GUSH_SUFFI",
                            "PARCEL"
                        ],
                        "format": "$1-$2-$3"
                    },
                    "notes": "pid is gush (block)-gush suffix-helka (parcel), unique across the file"
                }
            }
        ]
    }
}
