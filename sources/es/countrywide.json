{
    "coverage": {
        "ISO 3166": {
            "alpha2": "ES",
            "country": "Spain"
        },
        "country": "es"
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "country",
                "data": "https://data.openaddresses.io/cache/uploads/jeffdefacto/2026-11-11-5r8yr/es_addresses.csv.zip",
                "website": "https://centrodedescargas.cnig.es/CentroDescargas/buscadorCatalogo.do",
                "note": "Addresses comes in 52 regional packages in gpkg format combined with some parcel and municipal data. These were processed by trimming the data down to addresses, merging into one layer, and converting to CSV.",
                "license": {
                    "text": "CC BY 4.0",
                    "url": "https://www.ign.es/resources/licencia/Condiciones_licenciaUso_IGN.pdf",
                    "attribution": true,
                    "share-alike": false,
                    "attribution name": "scne.es"
                },
                "protocol": "http",
                "compression": "zip",
                "conform": {
                    "lon": "X",
                    "lat": "Y",
                    "number": "numero",
                    "unit": "extension",
                    "street": {
                        "function": "chain",
                        "variable": "street_wip",
                        "functions": [
                            {
                                "function": "join",
                                "fields": [
                                    "tipo_vial",
                                    "nombre_via"
                                ],
                                "separator": " "
                            },
                            {
                                "function": "regexp",
                                "field": "oa:street_wip",
                                "pattern": "^([^()]*\\([^()]*)$",
                                "replace": "$1)"
                            },
                            {
                                "function": "first_non_empty",
                                "fields": [
                                    "street_wip"
                                ]
                            }
                        ]
                    },
                    "postcode": "cod_postal",
                    "city": "municipio",
                    "district": "provincia",
                    "region": "comunidad_autonoma",
                    "format": "csv",
                    "srs": "EPSG:4258"
                }
            }
        ]
    }
}
