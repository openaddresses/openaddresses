                "protocol": "http",
                "compression": "zip",
                "conform": {
                    "encoding": "UTF-8",
                    "format": "shapefile",
                    "file": "Ekas.shp",
                    "id": "KODS",
                    "number": "NOSAUKUMS",
                    "street": {
                        "function": "chain",
                        "variable": "street_seg",
                        "functions": [
                            {
                                "function": "regexp",
                                "field": "STD",
                                "pattern": "^(?!\")([^,]*)",
                                "replace": "$1"
                            },
                            {
                                "function": "remove_postfix",
                                "field": "oa:street_seg",
                                "field_to_remove": "NOSAUKUMS"
                            }
                        ]
                    },
                    "city": {
                        "function": "regexp",
                        "field": "STD",
                        "pattern": "^[^,]*,\\s*([^,]*),",
                        "replace": "$1"
                    },
                    "district": {
                        "function": "regexp",
                        "field": "STD",
                        "pattern": "^[^,]*,[^,]*,\\s*([^,]*),",
                        "replace": "$1"
                    },
                    "postcode": "ATRIB"
                }
            }
        ]
    }
}
