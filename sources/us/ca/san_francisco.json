{
    "coverage": {
        "US Census": {
            "geoid": "06075",
            "name": "City and County of San Francisco",
            "state": "California"
        },
        "country": "us",
        "state": "ca",
        "county": "san francisco"
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "county",
                "data": "https://data.sfgov.org/api/v3/views/ramy-di5m/query.csv?query=SELECT%20%60eas_fullid%60%2C%20%60address_number%60%2C%20%60address_number_suffix%60%2C%20%60street_name%60%2C%20%60street_type%60%2C%20%60unit_number%60%2C%20%60zip_code%60%2C%20%60longitude%60%20AS%20%60Longitude%60%2C%20%60latitude%60%20AS%20%60Latitude%60",
                "license": {
                    "url": "https://opendatacommons.org/licenses/pddl/1-0/",
                    "text": "Public Domain Dedication and License (PDDL) v1.0",
                    "attribution": false,
                    "share-alike": false,
                    "attribution name": "City and County of San Francisco"
                },
                "website": "https://data.sfgov.org/Geographic-Locations-and-Boundaries/Addresses-with-Units-Enterprise-Addressing-System/ramy-di5m",
                "protocol": "http",
                "conform": {
                    "format": "csv",
                    "accuracy": 2,
                    "number":[
                            "address_number",
                            "address_number_suffix"
                        ],
                    "street": {
                        "function": "chain",
                        "variable": "street_wip",
                        "functions": [
                            {
                                "function": "join",
                                "fields": [
                                    "street_name",
                                    "street_type"
                                ],
                                "separator": " "
                            },
                            {
                                "function": "regexp",
                                "field": "oa:street_wip",
                                "pattern": "(?i)\\b0+([1-9][0-9]*(?:ST|ND|RD|TH))\\b|^",
                                "replace": "$1"
                            }
                        ]
                    },
                    "unit": "unit_number",
                    "postcode": "zip_code",
                    "city": {
                        "function": "constant",
                        "value": "San Francisco"
                    },
                    "region": {
                        "function": "constant",
                        "value": "CA"
                    },
                    "id": "eas_fullid",
                    "lon": "Longitude",
                    "lat": "Latitude"
                },
                "test": {
                    "enabled": true,
                    "description": "single-digit ordinal street names are zero-padded in the source (05TH); the padding is dropped so they match the road network",
                    "acceptance-tests": [
                        {
                            "description": "a zero-padded ordinal loses its padding",
                            "inputs": {
                                "eas_fullid": "1",
                                "address_number": "1450",
                                "address_number_suffix": "",
                                "street_name": "05TH",
                                "street_type": "ST",
                                "unit_number": "",
                                "zip_code": "94103",
                                "Longitude": "-122.4",
                                "Latitude": "37.78"
                            },
                            "expected": {
                                "street": "5TH ST"
                            }
                        },
                        {
                            "description": "multi-digit ordinals are unchanged",
                            "inputs": {
                                "eas_fullid": "2",
                                "address_number": "100",
                                "address_number_suffix": "",
                                "street_name": "10TH",
                                "street_type": "AVE",
                                "unit_number": "",
                                "zip_code": "94118",
                                "Longitude": "-122.4",
                                "Latitude": "37.78"
                            },
                            "expected": {
                                "street": "10TH AVE"
                            }
                        },
                        {
                            "description": "named streets are unchanged",
                            "inputs": {
                                "eas_fullid": "3",
                                "address_number": "1670",
                                "address_number_suffix": "",
                                "street_name": "MARKET",
                                "street_type": "ST",
                                "unit_number": "",
                                "zip_code": "94102",
                                "Longitude": "-122.4",
                                "Latitude": "37.78"
                            },
                            "expected": {
                                "street": "MARKET ST"
                            }
                        }
                    ]
                }
            }
        ],
        "parcels": [
            {
                "name": "county",
                "data": "https://data.sfgov.org/api/geospatial/acdm-wktn?query=SELECT%20%60active%60%2C%20%60blklot%60%2C%20%60shape%60%0AWHERE%20%60active%60%20%3D%20TRUE%0AORDER%20BY%20%60active%60%20ASC%20NULL%20LAST&fourfour=acdm-wktn&accessType=DOWNLOAD&method=export&format=Shapefile",
                "license": {
                    "url": "https://opendatacommons.org/licenses/pddl/1-0/",
                    "text": "Public Domain Dedication and License (PDDL) v1.0",
                    "attribution": false,
                    "share-alike": false
                },
                "website": "https://data.sfgov.org/Geographic-Locations-and-Boundaries/Parcels-Active-and-Retired/acdm-wktn",
                "protocol": "http",
                "compression": "zip",
                "conform": {
                    "format": "shapefile",
                    "pid": "blklot"
                }
            }
        ],
        "buildings": [
            {
                "name": "county",
                "data": "https://data.sfgov.org/api/geospatial/ynuv-fyni?query=SELECT%20%60globalid%60%2C%20%60shape%60&fourfour=ynuv-fyni&accessType=DOWNLOAD&method=export&format=GeoJSON",
                "license": {
                    "url": "https://opendatacommons.org/licenses/pddl/1-0/",
                    "text": "Public Domain Dedication and License (PDDL) v1.0",
                    "attribution": false,
                    "share-alike": false
                },
                "website": "https://data.sfgov.org/Geographic-Locations-and-Boundaries/Building-Footprints/ynuv-fyni",
                "protocol": "http",
                "conform": {
                    "format": "geojson"
                }
            }
        ],
        "centerlines": [
            {
                "name": "county",
                "data": "https://services.arcgis.com/Zs2aNLFN00jrS4gG/arcgis/rest/services/Street_Centerline/FeatureServer/0",
                "protocol": "ESRI",
                "conform": {
                    "format": "geojson",
                    "id": "cnn",
                    "name": "streetname",
                    "classification": {
                        "function": "map",
                        "field": "classcode",
                        "mapping": {
                            "1": "primary",
                            "5": "residential",
                            "0": "service"
                        },
                        "else": "residential"
                    },
                    "addr_from_left": "lf_fadd",
                    "addr_to_left": "lf_toadd",
                    "addr_from_right": "rt_fadd",
                    "addr_to_right": "rt_toadd",
                    "zip_left": "zip_code",
                    "zip_right": "zip_code"
                }
            }
        ]
    }
}
