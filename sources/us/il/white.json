{
    "coverage": {
        "US Census": {
            "geoid": "17193",
            "name": "White County",
            "state": "Illinois"
        },
        "country": "us",
        "state": "il",
        "county": "White"
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "county",
                "data": "https://services.arcgis.com/4YineAQdtmx0tv46/ArcGIS/rest/services/Parcels_WhiteIL2/FeatureServer/0",
                "protocol": "ESRI",
                "conform": {
                    "format": "geojson",
                    "number": {
                        "function": "prefixed_number",
                        "field": "site_address"
                    },
                    "street": {
                        "function": "postfixed_street",
                        "field": "site_address"
                    },
                    "city": {
                        "function": "regexp",
                        "field": "Site_City_State_Zip",
                        "pattern": "^(.+?)\\s+IL"
                    },
                    "region": {
                        "function": "regexp",
                        "field": "Site_City_State_Zip",
                        "pattern": "\\b(IL)\\b"
                    },
                    "postcode": {
                        "function": "regexp",
                        "field": "Site_City_State_Zip",
                        "pattern": "(\\d+)$"
                    }
                },
                "test": {
                    "enabled": true,
                    "description": "these are the tests that exercise valid inputs for czech countrywide",
                    "acceptance-tests": [
                        {
                            "description": "has city/state/zip",
                            "inputs": {
                                "site_address": "216 E COMMERCE ST",
                                "Site_City_State_Zip": "GRAYVILLE IL 62844"
                            },
                            "expected": {
                                "number": "216",
                                "street": "E COMMERCE ST",
                                "city": "GRAYVILLE",
                                "region": "IL",
                                "postcode": "62844"
                            }
                        },
                        {
                            "description": "has city/state, no zip",
                            "inputs": {
                                "site_address": "220 E COMMERCE ST",
                                "Site_City_State_Zip": "GRAYVILLE IL"
                            },
                            "expected": {
                                "number": "220",
                                "street": "E COMMERCE ST",
                                "city": "GRAYVILLE",
                                "region": "IL",
                                "postcode": ""
                            }
                        }
                    ]
                }
            }
        ],
        "parcels": [
            {
                "name": "county",
                "data": "https://services.arcgis.com/4YineAQdtmx0tv46/ArcGIS/rest/services/Parcels_WhiteIL2/FeatureServer/0",
                "protocol": "ESRI",
                "conform": {
                    "format": "geojson",
                    "pid": "PIN"
                }
            }
        ]
    }
}
