{
    "coverage": {
        "US Census": {
            "geoid": "17101",
            "name": "Lawrence County",
            "state": "Illinois"
        },
        "country": "us",
        "state": "il",
        "county": "Lawrence"
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "county",
                "data": "https://services2.bhamaps.com/arcgis/rest/services/AGS_lawrence_co_il_taxmap/MapServer/0",
                "protocol": "ESRI",
                "conform": {
                    "number": {
                        "function": "regexp",
                        "field": "location",
                        "pattern": "^([0-9]+)"
                    },
                    "street": {
                        "function": "regexp",
                        "field": "location",
                        "pattern": "^(?:[0-9]+ )([^;]+);.*$",
                        "replace": "$1"
                    },
                    "postcode": {
                        "function": "regexp",
                        "field": "location",
                        "pattern": "(?:.*;[\\s]*)([0-9]+(?:\\-[0-9]+)?)$",
                        "replace": "$1"
                    },
                    "format": "geojson"
                },
                "skip": true,
                "note": "bhamaps.com servers are dead as of 2026-04"
            }
        ],
        "parcels": [
            {
                "name": "county",
                "data": "https://services2.arcgis.com/AtoBX9sHdZu4i3gx/arcgis/rest/services/Parcels/FeatureServer/0",
                "protocol": "ESRI",
                "conform": {
                    "format": "geojson",
                    "pid": "IndexNumber"
                },
                "note": "Called assessor's office to confirm correct PIN attribute. Use `IndexNumber`, not `GISPin`. They have completely different values."
            }
        ]
    }
}
