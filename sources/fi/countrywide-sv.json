{
    "coverage": {
        "country": "fi",
        "ISO 3166": {
            "alpha2": "FI",
            "country": "Finland"
        }
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "country",
                "protocol": "http",
                "compression": "zip",
                "year": "2025",
                "data": "https://data.openaddresses.io/cache/uploads/jeffdefacto/2026-06-03-i0x71/open_address.csv.zip",
                "license": {
                    "url": "https://creativecommons.org/licences/by/4.0/deed.fi",
                    "text": "CC BY 4.0",
                    "attribution": true,
                    "attribution name": "Syke"
                },
                "website": "https://www.syke.fi/en/environmental-data/open-web-services/web-map-services#addresses",
                "conform": {
                    "lat": "y",
                    "lon": "x",
                    "street": {
                        "function": "first_non_empty",
                        "fields": ["address_name_swe", "address_name_fin"]
                    },
                    "number": {
                        "function": "format",
                        "fields": ["number_part_of_address_number", "subdivision_letter_of_address_number", "number_part_of_address_number2", "subdivision_letter_of_address_number2"],
                        "format": "$1$2-$3$4"
                    },
                    "id": "address_key",
                    "city": {
                        "function": "first_non_empty",
                        "fields": ["postal_office_swe", "postal_office_fin"]
                    },
                    "postcode": "postal_code",
                    "format": "csv",
                    "accuracy": 1
                },
                "language": "sv"
            }
        ]
    }
}
