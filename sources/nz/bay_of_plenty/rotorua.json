{
    "coverage": {
        "country": "nz",
        "state": "bop",
        "county": "Rotorua"
    },
    "schema": 2,
    "layers": {
        "addresses": [
            {
                "name": "county",
                "data": "https://gis.rdc.govt.nz/server/rest/services/Core/Cadastral/MapServer/145",
                "website": "https://rotorua.maps.arcgis.com/home/item.html?id=8ade72d1d1f548a6b204b44a5dd957e6",
                "protocol": "ESRI",
                "license": {
                    "url": "https://creativecommons.org/licenses/by/4.0/",
                    "text": "CC BY 4.0",
                    "attribution": true,
                    "attribution name": "Rotorua Lakes Council",
                    "presumed": true
                },
                "conform": {
                    "format": "geojson",
                    "number": {
                        "function": "regexp",
                        "field": "AddressLabel",
                        "pattern": "^(?:.*/)?(.+)$",
                        "replace": "$1"
                    },
                    "street": "RoadLabel",
                    "unit": {
                        "function": "regexp",
                        "field": "AddressLabel",
                        "pattern": "^([^/]+)/.*$",
                        "replace": "$1"
                    }
                }
            }
        ]
    }
}
